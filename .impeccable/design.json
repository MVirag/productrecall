      "css": ".ds-chip{position:relative;display:inline-flex;align-items:center;gap:8px;min-height:36px;padding:0 12px;font:400 1.0625rem system-ui,sans-serif;border:2px solid #5b6b62;border-radius:999px;background:#fff;color:#10201a;cursor:pointer}.ds-chip::before{content:\"\";position:absolute;inset:-6px -2px}.ds-chip:hover{border-color:#10201a;background:#d9e4de}.ds-chip:active{background:#c3d1c9}.ds-chip[aria-pressed=true]{background:#10201a;border-color:#10201a;color:#fff;font-weight:700}.ds-chip[aria-pressed=true]::after{content:\"\";order:-1;width:14px;height:11px;background:currentColor;clip-path:polygon(14% 44%,0 65%,50% 100%,100% 16%,80% 0,43% 62%)}.ds-chip:focus-visible{outline:3px solid #1a5fb4;outline-offset:2px}"
