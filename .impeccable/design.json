  "narrative": {
    "northStar": "The Door Sticker",
    "overview": "Every recall is a food-inspection door sticker, the severity scale a Dane already reads at a glance. The level lives in one object: a die-cut round badge holding its own shape, set in a framed white sticker on a mint-tinted ground. A graphite-green bar holds two pill nav items. Ink is the only brand fill; there is no brand hue to compete with a warning. The system is flat: depth comes from frames and tonal steps, never from shadows.",
    "keyCharacteristics": [
      "One 56px die-cut badge per level, shape plus colour, never colour alone.",
      "Thick ink frame (2px) on every sticker; the health sticker takes a 5px red frame and a red tint ground.",
      "Ink is the only brand fill: primary button, selected chip, relevance seal.",
      "Flat slabs for controls with an ink edge; pressed sinks 1px.",
      "Light and dark both mint-tinted, never plain gray."
    ],
    "rules": [
      { "name": "The Red Is Health Rule", "body": "Red appears only for the health level: its badge, frame, tint, and the bad pack-check result. It is never brand, hover, selection, or decoration.", "section": "colors" },
      { "name": "The Ink Is The Brand Rule", "body": "The only brand fill is ink. Primary button, selected chip and relevance seal are ink; there is no brand hue.", "section": "colors" },
      { "name": "The Shape Beside The Colour Rule", "body": "Every level has its own shape inside the badge; colour is never the only signal.", "section": "colors" },
      { "name": "The Relevance Is Black Rule", "body": "This concerns you is a black ink seal and a double frame; it never recolours the severity.", "section": "colors" },
      { "name": "The Tokens Only Rule", "body": "Font sizes come from --fs-* / --lh-* in rem; no literal sizes. Dates and dd use tabular numerals.", "section": "typography" },
      { "name": "The Sentence-Case Verdict Rule", "body": "The verdict is sentence case at weight 800; there are no uppercase kickers or eyebrows.", "section": "typography" },
      { "name": "The Flat Slab Rule", "body": "Controls are flat slabs with an ink edge. Hover tints, pressed sinks, focus is the blue ring. No shadows, no gradients.", "section": "elevation" }
    ],
    "dos": [
      "Do give every level its own badge shape and keep the verdict in sentence case.",
      "Do keep text at 4.5:1 and control edges, focus rings and badge glyphs at 3:1 in both themes; test/contrast.test.js reads the tokens from styles.css. Add a pair there when you add a colour token.",
      "Do keep voice short and plain: Danish first, English second, imperative.",
      "Do keep buttons, inputs and nav targets at 48px; chips 36px with a 48px hit area, 12px between rows.",
      "Do gate hover with @media (hover: hover) and style :active for all input methods.",
      "Do show relevance with the black seal and double frame."
    ],
    "donts": [
      "Don't use red for anything but the health level: not hover, selection or brand.",
      "Don't use colour as the only signal of a level.",
      "Don't add shadows, gradients or underlines on nav.",
      "Don't introduce a brand hue; ink is the only brand fill.",
      "Don't write font sizes as literals.",
      "Don't let the pack check read \"no match\" as safe on health, allergy, possible or unstated."
    ]
  }
}
