      "html": "<a class=\"ds-sticker\" href=\"#\"><span class=\"ds-die\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M7.86 2h8.28L22 7.86v8.28L16.14 22H7.86L2 16.14V7.86Z\"/><path d=\"M12 8v4M12 16h.01\"/></svg></span><span class=\"ds-body\"><p class=\"ds-verdict\">Helbredsfare</p><p class=\"ds-product\">Eksempel pølser</p><p class=\"ds-meta\">Salmonella</p></span></a>",
