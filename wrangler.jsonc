{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "productrecall",
  // Keep the public https://productrecall.<subdomain>.workers.dev address on.
  "workers_dev": true,
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Every 15 minutes (UTC). Fødevarestyrelsen publishes ~5-15 recalls a month.
  "triggers": { "crons": ["*/15 * * * *"] },
  // No id: `wrangler deploy` creates the KV namespace on the first deploy.
  "kv_namespaces": [{ "binding": "KV" }],
  // Workers AI, used to translate recalls to English (free daily allowance).
  "ai": { "binding": "AI" },
  "vars": {
    // Contact URL sent to push services in the VAPID token. Set to your workers.dev URL.
    "VAPID_SUBJECT": "https://tilbagekald-alert.workers.dev"
  },
  // Push (VAPID) keys are generated automatically and kept in KV.
  // Optional secrets: VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY (to pin keys),
  // ADMIN_TOKEN (enables POST /api/admin/poll).
  // Our own log lines (one summary per check, errors) stay; the automatic per-request invocation logs are off
  // so that request details such as IP addresses are not kept in logs.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Trial ("preview") builds that Cloudflare makes for pull-request branches.
  // No cron there, and deliberately no KV: a preview can never read or push
  // to real subscriptions. Production deploys from main ignore this block.
  "previews": {
    "vars": { "VAPID_SUBJECT": "https://productrecall.workers.dev" },
    "ai": { "binding": "AI" }
  }
}
